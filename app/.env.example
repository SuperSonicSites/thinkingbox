# ===========================================
# ISP-by-Address Canada — Environment Variables
# ===========================================
# Copy to .env.local and fill in values.
# For local dev, only DATABASE_URL is needed (auto-set by docker compose).

# --- Local Dev (required) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ispbyaddress

# --- Geocoding ---
# Set to "mock" for local dev (default), "google" for production
GEOCODE_PROVIDER=mock
GOOGLE_PLACES_API_KEY=

# --- Cloudflare (production only) ---
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
HYPERDRIVE_ID=
R2_BUCKET_NAME=
KV_NAMESPACE_ID=

# --- Auth / Email (Phase 2+) ---
RESEND_API_KEY=

# --- Monitoring (production only) ---
SENTRY_DSN=

# --- Feature flags ---
MOCK_PLANS=true
# Set to false in production when real plan data is loaded
