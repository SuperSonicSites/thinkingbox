---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/common/Header.astro";
import Footer from "@/components/common/Footer.astro";
import Breadcrumbs from "@/components/seo/Breadcrumbs.astro";
import { t } from "@/i18n/utils";
import { getGuides } from "@/lib/seo/data";

export const prerender = true;

const locale = "en";
const guides = getGuides();

const crumbs = [
  { name: "Home", href: "/" },
  { name: t(locale, "common.guides_hub"), href: "/guides" },
];
---

<BaseLayout title={t(locale, "seo.guides_title")} description={t(locale, "seo.guides_description")} locale={locale} canonicalPath="/guides">
  <Header locale={locale} />

  <main id="main-content" class="py-12 md:py-16">
    <div class="container-page">
      <Breadcrumbs crumbs={crumbs} />

      <div class="max-w-3xl">
        <h1 class="font-[var(--font-display)] text-3xl font-bold tracking-tight text-text-primary md:text-4xl">{t(locale, "common.guides_hub")}</h1>
        <p class="mt-4 text-lg text-text-secondary">Expert guides to help you choose the best internet service in Canada.</p>
      </div>

      <div class="mt-10 grid gap-6 sm:grid-cols-2">
        {guides.map((guide) => (
          <a href={`/guides/${guide.slug}`} class="group rounded-[var(--radius-lg)] border border-border-subtle bg-surface-raised p-6 shadow-card transition-all hover:border-primary-300 hover:shadow-card-hover hover:-translate-y-0.5">
            <div class="font-[var(--font-display)] text-lg font-bold text-text-primary group-hover:text-primary-600 transition-colors">{guide.title_en}</div>
            <p class="mt-2 text-sm text-text-secondary line-clamp-2">{guide.description_en}</p>
            <div class="mt-3 text-xs text-text-muted">
              {t(locale, "common.reading_time").replace("{{minutes}}", String(guide.reading_time_minutes))}
            </div>
          </a>
        ))}
      </div>
    </div>
  </main>

  <Footer locale={locale} />
</BaseLayout>
