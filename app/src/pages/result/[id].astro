---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/common/Header.astro";
import Footer from "@/components/common/Footer.astro";
import ResultsView from "@/components/results/ResultsView";
import { t } from "@/i18n/utils";

const locale = "en";
const { id } = Astro.params;

// In a full implementation, this would fetch the cached result by lookup_id.
// For now, we pass the result via query params or session storage on the client side.
// The ResultsView component handles fetching if needed.
---

<BaseLayout
  title={`${t(locale, "results.title")} — ISP by Address Canada`}
  description={t(locale, "seo.lookup_description")}
  locale={locale}
  canonicalPath={`/result/${id}`}
>
  <Header locale={locale} />

  <main id="main-content" class="py-8 md:py-12">
    <div class="container-page">
      <ResultsView lookupId={id ?? ""} locale={locale} client:load />
    </div>
  </main>

  <Footer locale={locale} />
</BaseLayout>
