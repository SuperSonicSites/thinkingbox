---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/common/Header.astro";
import Footer from "@/components/common/Footer.astro";
import Breadcrumbs from "@/components/seo/Breadcrumbs.astro";

export const prerender = true;

const locale = "en";
---

<BaseLayout
  title="Privacy Policy — ISP by Address Canada"
  description="Privacy policy for ISP by Address Canada. Learn how we collect, use, and protect your data."
  locale={locale}
  canonicalPath="/privacy"
>
  <Header locale={locale} />

  <main id="main-content" class="py-12 md:py-16">
    <div class="container-page">
      <Breadcrumbs crumbs={[
        { name: "Home", href: "/" },
        { name: "Privacy Policy", href: "/privacy" },
      ]} />

      <article class="prose mx-auto max-w-3xl">
        <h1 class="text-3xl font-bold tracking-tight text-[var(--color-text-primary)] md:text-4xl">
          Privacy Policy
        </h1>
        <p class="mt-2 text-sm text-[var(--color-text-muted)]">Last updated: February 2026</p>

        <div class="mt-8 space-y-8 text-[var(--color-text-secondary)] leading-relaxed">
          <section>
            <h2 class="text-xl font-bold text-[var(--color-text-primary)]">Overview</h2>
            <p class="mt-3">
              ISP by Address Canada ("we", "us", or "our") operates the website ispbyaddress.ca. This page informs you of our policies regarding the collection, use, and disclosure of personal information when you use our service.
            </p>
          </section>

          <section>
            <h2 class="text-xl font-bold text-[var(--color-text-primary)]">Information We Collect</h2>
            <p class="mt-3">When you use our address lookup feature, we process the following information:</p>
            <ul class="mt-3 list-disc space-y-2 pl-6">
              <li><strong>Address data:</strong> The Canadian address you enter is sent to Google Places API for geocoding. We do not permanently store the addresses you search.</li>
              <li><strong>Usage data:</strong> We collect anonymized usage statistics such as page views, feature usage, and general geographic region (province-level) to improve our service.</li>
              <li><strong>Discrepancy reports:</strong> If you voluntarily submit a data correction report, we store the information you provide to improve data accuracy.</li>
            </ul>
          </section>

          <section>
            <h2 class="text-xl font-bold text-[var(--color-text-primary)]">Data Sources</h2>
            <p class="mt-3">
              The broadband coverage data displayed on this site comes from the <a href="https://ised-isde.canada.ca/site/high-speed-internet-canada/en/universal-broadband-fund/broadband-coverage" target="_blank" rel="noopener noreferrer" class="text-[var(--color-primary-500)] underline underline-offset-2 hover:text-[var(--color-primary-600)]">ISED National Broadband Data</a>, which is publicly available open data from the Government of Canada. Provider plan information is curated from publicly available sources.
            </p>
          </section>

          <section>
            <h2 class="text-xl font-bold text-[var(--color-text-primary)]">Third-Party Services</h2>
            <p class="mt-3">We use the following third-party services:</p>
            <ul class="mt-3 list-disc space-y-2 pl-6">
              <li><strong>Google Places API:</strong> For address geocoding. Google's privacy policy applies to this processing.</li>
              <li><strong>Cloudflare:</strong> For hosting, CDN, and security. Cloudflare processes standard web request data (IP address, user agent).</li>
            </ul>
          </section>

          <section>
            <h2 class="text-xl font-bold text-[var(--color-text-primary)]">Cookies</h2>
            <p class="mt-3">
              We use minimal, essential cookies for site functionality (such as language preference). We do not use advertising cookies or third-party tracking cookies.
            </p>
          </section>

          <section>
            <h2 class="text-xl font-bold text-[var(--color-text-primary)]">Data Retention</h2>
            <p class="mt-3">
              Address lookups are cached temporarily (up to 24 hours) to improve performance and are not linked to any personal identifier. Anonymized usage analytics are retained for up to 12 months.
            </p>
          </section>

          <section>
            <h2 class="text-xl font-bold text-[var(--color-text-primary)]">Your Rights</h2>
            <p class="mt-3">
              Under Canadian privacy legislation (PIPEDA), you have the right to access, correct, or delete your personal information. Since we collect minimal personal data, most users will not have personal data stored in our systems. If you have submitted a discrepancy report and wish to have it removed, please contact us.
            </p>
          </section>

          <section>
            <h2 class="text-xl font-bold text-[var(--color-text-primary)]">Contact</h2>
            <p class="mt-3">
              If you have questions about this privacy policy, please contact us at <span class="font-mono text-[var(--color-text-primary)]">privacy@ispbyaddress.ca</span>.
            </p>
          </section>
        </div>
      </article>
    </div>
  </main>

  <Footer locale={locale} />
</BaseLayout>
