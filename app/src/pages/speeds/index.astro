---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/common/Header.astro";
import Footer from "@/components/common/Footer.astro";
import Breadcrumbs from "@/components/seo/Breadcrumbs.astro";
import { t } from "@/i18n/utils";
import { getSpeedTiers } from "@/lib/seo/data";

export const prerender = true;

const locale = "en";
const tiers = getSpeedTiers();

const crumbs = [
  { name: "Home", href: "/" },
  { name: t(locale, "common.speed_guide"), href: "/speeds" },
];
---

<BaseLayout title={t(locale, "seo.speeds_title")} description={t(locale, "seo.speeds_description")} locale={locale} canonicalPath="/speeds">
  <Header locale={locale} />

  <main id="main-content" class="py-12 md:py-16">
    <div class="container-page">
      <Breadcrumbs crumbs={crumbs} />

      <div class="max-w-3xl">
        <h1 class="font-[var(--font-display)] text-3xl font-bold tracking-tight text-text-primary md:text-4xl">{t(locale, "common.speed_guide")}</h1>
        <p class="mt-4 text-lg text-text-secondary">Find the right internet speed for your household. Compare speed tiers with activity recommendations.</p>
      </div>

      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {tiers.map((tier) => (
          <a href={`/speeds/${tier.slug}`} class="group rounded-[var(--radius-lg)] border border-border-subtle bg-surface-raised p-6 shadow-card transition-all hover:border-primary-300 hover:shadow-card-hover hover:-translate-y-0.5">
            <div class="font-[var(--font-display)] text-lg font-bold text-text-primary group-hover:text-primary-600 transition-colors">{tier.name_en}</div>
            <p class="mt-2 text-sm text-text-secondary line-clamp-2">{tier.description_en}</p>
            <div class="mt-4 flex items-center gap-4 text-xs text-text-muted">
              <span>{tier.household_size}</span>
              <span>{tier.typical_price_range_en}</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </main>

  <Footer locale={locale} />
</BaseLayout>
