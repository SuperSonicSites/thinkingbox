---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/common/Header.astro";
import Footer from "@/components/common/Footer.astro";
import Breadcrumbs from "@/components/seo/Breadcrumbs.astro";
import FAQSection from "@/components/seo/FAQSection.astro";
import ReviewScoreCard from "@/components/compare/ReviewScoreCard.astro";
import { t } from "@/i18n/utils";
import { getComparisons, getComparisonBySlug, getISPBySlug, getProvinceByCode } from "@/lib/seo/data";
import { buildISPReviewSummary } from "@/lib/seo/reviews";

export const prerender = true;

export function getStaticPaths() {
  return getComparisons().map((c) => ({ params: { matchup: c.slug } }));
}

const locale = "en";
const { matchup } = Astro.params;
const comparison = getComparisonBySlug(matchup ?? "");
if (!comparison) return Astro.redirect("/compare");

const providerA = getISPBySlug(comparison.provider_a_slug);
const providerB = getISPBySlug(comparison.provider_b_slug);
if (!providerA || !providerB) return Astro.redirect("/compare");

const summaryA = buildISPReviewSummary(providerA);
const summaryB = buildISPReviewSummary(providerB);
const winner = summaryA.overall === summaryB.overall ? null : summaryA.overall > summaryB.overall ? providerA.name : providerB.name;

const seoTitle = `${providerA.name} vs ${providerB.name}: Which ISP Is Better in 2026? — ISP by Address Canada`;
const seoDesc = `Compare ${providerA.name} and ${providerB.name} internet service. Coverage, speeds, pricing, and technologies compared side by side.`;

const crumbs = [
  { name: "Home", href: "/" },
  { name: t(locale, "common.comparisons_hub"), href: "/compare" },
  { name: `${providerA.name} vs ${providerB.name}`, href: `/compare/${comparison.slug}` },
];

const jsonLdExtra = [
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: `${providerA.name} vs ${providerB.name}`,
    itemListElement: [
      { "@type": "ListItem", position: 1, name: providerA.name },
      { "@type": "ListItem", position: 2, name: providerB.name },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: comparison.faqs_en.map((faq) => ({
      "@type": "Question",
      name: faq.question,
      acceptedAnswer: { "@type": "Answer", text: faq.answer },
    })),
  },
];
---

<BaseLayout title={seoTitle} description={seoDesc} locale={locale} canonicalPath={`/compare/${comparison.slug}`} jsonLdExtra={jsonLdExtra}>
  <Header locale={locale} />

  <main id="main-content" class="py-12 md:py-16">
    <div class="container-page">
      <Breadcrumbs crumbs={crumbs} />

      <div class="max-w-4xl">
        <h1 class="font-[var(--font-display)] text-3xl font-bold tracking-tight text-text-primary md:text-4xl">
          {providerA.name} vs {providerB.name}
        </h1>
        <p class="mt-4 text-lg text-text-secondary">
          Deep side-by-side comparison with coverage context, technology differences, and customer review ratings.
        </p>
      </div>

      <section class="mt-8 rounded-[var(--radius-lg)] border border-primary-200 bg-primary-50 p-6 shadow-card">
        <h2 class="font-[var(--font-display)] text-lg font-bold text-primary-700 mb-2">{t(locale, "common.quick_verdict")}</h2>
        <p class="text-sm leading-relaxed text-text-secondary">{comparison.verdict_en}</p>
        {winner && <p class="mt-3 text-sm font-semibold text-primary-700">Current review edge: {winner}</p>}
      </section>

      <section class="mt-10">
        <h2 class="font-[var(--font-display)] text-2xl font-bold tracking-tight text-text-primary mb-6">Review Ratings Snapshot</h2>
        <div class="grid gap-6 md:grid-cols-2">
          <ReviewScoreCard providerName={providerA.name} summary={summaryA} locale={locale} />
          <ReviewScoreCard providerName={providerB.name} summary={summaryB} locale={locale} />
        </div>
      </section>

      <section class="mt-10">
        <h2 class="font-[var(--font-display)] text-2xl font-bold tracking-tight text-text-primary mb-6">Side-by-Side Comparison</h2>
        <div class="overflow-x-auto rounded-[var(--radius-lg)] border border-border-subtle bg-surface-raised p-4 shadow-card">
          <table class="w-full text-left text-sm">
            <thead>
              <tr class="border-b border-border">
                <th class="pb-3 pr-4 font-medium text-text-muted">Feature</th>
                <th class="pb-3 pr-4 font-semibold text-text-primary">{providerA.name}</th>
                <th class="pb-3 font-semibold text-text-primary">{providerB.name}</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-border-subtle">
              <tr>
                <td class="py-3 pr-4 font-medium text-text-muted">Review score</td>
                <td class="py-3 pr-4 text-text-secondary">{summaryA.overall.toFixed(1)} / 5 ({summaryA.reviewCount.toLocaleString("en-CA")} reviews)</td>
                <td class="py-3 text-text-secondary">{summaryB.overall.toFixed(1)} / 5 ({summaryB.reviewCount.toLocaleString("en-CA")} reviews)</td>
              </tr>
              <tr>
                <td class="py-3 pr-4 font-medium text-text-muted">Type</td>
                <td class="py-3 pr-4 capitalize text-text-secondary">{providerA.ownership_type}</td>
                <td class="py-3 capitalize text-text-secondary">{providerB.ownership_type}</td>
              </tr>
              <tr>
                <td class="py-3 pr-4 font-medium text-text-muted">{t(locale, "common.technologies")}</td>
                <td class="py-3 pr-4 text-text-secondary">{providerA.technologies.join(", ")}</td>
                <td class="py-3 text-text-secondary">{providerB.technologies.join(", ")}</td>
              </tr>
              <tr>
                <td class="py-3 pr-4 font-medium text-text-muted">Provinces</td>
                <td class="py-3 pr-4 text-text-secondary">{providerA.provinces_served.map((p) => getProvinceByCode(p)?.name_en ?? p.toUpperCase()).join(", ")}</td>
                <td class="py-3 text-text-secondary">{providerB.provinces_served.map((p) => getProvinceByCode(p)?.name_en ?? p.toUpperCase()).join(", ")}</td>
              </tr>
              <tr>
                <td class="py-3 pr-4 font-medium text-text-muted">{t(locale, "common.customers")}</td>
                <td class="py-3 pr-4 text-text-secondary">~{(providerA.customer_count_approx / 1000).toFixed(0)}K</td>
                <td class="py-3 text-text-secondary">~{(providerB.customer_count_approx / 1000).toFixed(0)}K</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <section class="mt-10">
        <div class="grid gap-6 md:grid-cols-2">
          <div class="rounded-[var(--radius-lg)] border border-border-subtle bg-surface-raised p-6 shadow-card">
            <h3 class="font-[var(--font-display)] text-lg font-bold text-text-primary mb-3">{providerA.name} {t(locale, "common.strengths")}</h3>
            <p class="text-sm leading-relaxed text-text-secondary">{providerA.description_en}</p>
            <a href={`/providers/${providerA.slug}`} class="mt-4 inline-block text-sm font-medium text-primary-600 transition-colors hover:text-primary-700">
              Learn more about {providerA.name} →
            </a>
          </div>
          <div class="rounded-[var(--radius-lg)] border border-border-subtle bg-surface-raised p-6 shadow-card">
            <h3 class="font-[var(--font-display)] text-lg font-bold text-text-primary mb-3">{providerB.name} {t(locale, "common.strengths")}</h3>
            <p class="text-sm leading-relaxed text-text-secondary">{providerB.description_en}</p>
            <a href={`/providers/${providerB.slug}`} class="mt-4 inline-block text-sm font-medium text-primary-600 transition-colors hover:text-primary-700">
              Learn more about {providerB.name} →
            </a>
          </div>
        </div>
      </section>

      <section class="mt-10">
        <h2 class="font-[var(--font-display)] text-2xl font-bold tracking-tight text-text-primary mb-4">{t(locale, "common.which_should_you_choose")}</h2>
        <p class="text-text-secondary leading-relaxed">
          The right choice depends on your address and priorities. Use the ratings as one input, then verify actual service availability at your exact location.
        </p>
      </section>

      <section class="mt-12">
        <div class="rounded-[var(--radius-xl)] bg-gradient-to-r from-primary-600 to-primary-700 p-8 text-center text-white shadow-card-hover md:p-12">
          <h2 class="font-[var(--font-display)] text-2xl font-bold md:text-3xl">{t(locale, "common.check_address_cta")}</h2>
          <p class="mx-auto mt-3 max-w-lg text-primary-100">See whether {providerA.name}, {providerB.name}, or other ISPs serve your location.</p>
          <a href="/" class="mt-6 inline-flex items-center gap-2 rounded-[var(--radius-md)] bg-white px-6 py-3 font-[var(--font-display)] font-semibold text-primary-700 shadow-card transition-colors hover:bg-primary-50">{t(locale, "nav.lookup")}</a>
        </div>
      </section>

      <FAQSection title={t(locale, "seo.faq_title")} faqs={comparison.faqs_en} />
    </div>
  </main>

  <Footer locale={locale} />
</BaseLayout>
