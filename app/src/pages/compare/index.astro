---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/common/Header.astro";
import Footer from "@/components/common/Footer.astro";
import Breadcrumbs from "@/components/seo/Breadcrumbs.astro";
import { t } from "@/i18n/utils";
import { getComparisons, getISPBySlug } from "@/lib/seo/data";
import { getISPReviewSummary } from "@/lib/seo/reviews";

export const prerender = true;

const locale = "en";
const comparisonCards = getComparisons().flatMap((comparison) => {
    const providerA = getISPBySlug(comparison.provider_a_slug);
    const providerB = getISPBySlug(comparison.provider_b_slug);
    if (!providerA || !providerB) return [];

    const summaryA = getISPReviewSummary(providerA.slug);
    const summaryB = getISPReviewSummary(providerB.slug);
    if (!summaryA || !summaryB) return [];

    const winner = summaryA.overall >= summaryB.overall ? providerA.name : providerB.name;

    return [{ comparison, summaryA, summaryB, winner }];
  });

const crumbs = [
  { name: t(locale, "common.home"), href: "/" },
  { name: t(locale, "common.comparisons_hub"), href: "/compare" },
];
---

<BaseLayout title={t(locale, "seo.comparisons_title")} description={t(locale, "seo.comparisons_description")} locale={locale} canonicalPath="/compare">
  <Header locale={locale} />

  <main id="main-content" class="py-12 md:py-16">
    <div class="container-page">
      <Breadcrumbs crumbs={crumbs} />

      <div class="max-w-3xl">
        <h1 class="font-[var(--font-display)] text-3xl font-bold tracking-tight text-text-primary md:text-4xl">{t(locale, "common.comparisons_hub")}</h1>
        <p class="mt-4 text-lg text-text-secondary">{t(locale, "compare.index_subtitle")}</p>
      </div>

      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {comparisonCards.map((card) => (
          <a href={`/compare/${card.comparison.slug}`} class="group rounded-[var(--radius-lg)] border border-border-subtle bg-surface-raised p-5 shadow-card transition-all hover:border-primary-300 hover:shadow-card-hover hover:-translate-y-0.5">
            <div class="font-[var(--font-display)] font-bold text-text-primary group-hover:text-primary-600 transition-colors">
              {card.comparison.provider_a_name} vs {card.comparison.provider_b_name}
            </div>
            <p class="mt-2 text-sm text-text-secondary line-clamp-2">{card.comparison.verdict_en}</p>
            <div class="mt-3 flex flex-wrap gap-2 text-xs">
              <span class="rounded-full bg-primary-50 px-2.5 py-1 text-primary-700">{card.comparison.provider_a_name}: {card.summaryA.overall.toFixed(1)}/5</span>
              <span class="rounded-full bg-primary-50 px-2.5 py-1 text-primary-700">{card.comparison.provider_b_name}: {card.summaryB.overall.toFixed(1)}/5</span>
            </div>
            <p class="mt-3 text-xs font-semibold text-primary-700">{t(locale, "compare.review_edge_prefix")} {card.winner}</p>
          </a>
        ))}
      </div>
    </div>
  </main>

  <Footer locale={locale} />
</BaseLayout>
