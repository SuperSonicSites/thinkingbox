---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/common/Header.astro";
import Footer from "@/components/common/Footer.astro";
import Breadcrumbs from "@/components/seo/Breadcrumbs.astro";

export const prerender = true;

const locale = "fr";
---

<BaseLayout
  title="Conditions d'utilisation — FSI par adresse Canada"
  description="Conditions d'utilisation de FSI par adresse Canada. Comprenez les conditions d'utilisation de notre service de recherche de couverture large bande."
  locale={locale}
  canonicalPath="/fr/terms"
>
  <Header locale={locale} />

  <main id="main-content" class="py-12 md:py-16">
    <div class="container-page">
      <Breadcrumbs crumbs={[
        { name: "Accueil", href: "/fr" },
        { name: "Conditions d'utilisation", href: "/fr/terms" },
      ]} />

      <article class="prose mx-auto max-w-3xl">
        <h1 class="text-3xl font-bold tracking-tight text-[var(--color-text-primary)] md:text-4xl">
          Conditions d'utilisation
        </h1>
        <p class="mt-2 text-sm text-[var(--color-text-muted)]">Dernière mise à jour : février 2026</p>

        <div class="mt-8 space-y-8 text-[var(--color-text-secondary)] leading-relaxed">
          <section>
            <h2 class="text-xl font-bold text-[var(--color-text-primary)]">Acceptation des conditions</h2>
            <p class="mt-3">
              En accédant et en utilisant FSI par adresse Canada (ispbyaddress.ca), vous acceptez d'être lié par ces conditions d'utilisation. Si vous n'êtes pas d'accord, veuillez ne pas utiliser ce service.
            </p>
          </section>

          <section>
            <h2 class="text-xl font-bold text-[var(--color-text-primary)]">Description du service</h2>
            <p class="mt-3">
              FSI par adresse Canada fournit des informations sur la couverture Internet large bande basées sur des données publiquement disponibles d'Innovation, Sciences et Développement économique Canada (ISDE). Le service permet aux utilisateurs de vérifier quels fournisseurs de services Internet peuvent être disponibles à une adresse canadienne donnée.
            </p>
          </section>

          <section>
            <h2 class="text-xl font-bold text-[var(--color-text-primary)]">Avis de non-responsabilité sur l'exactitude des données</h2>
            <p class="mt-3">
              Les données de couverture présentées sur ce site sont dérivées des données nationales sur le large bande d'ISDE et sont fournies « telles quelles ». Bien que nous nous efforcions d'assurer l'exactitude, nous ne pouvons garantir que :
            </p>
            <ul class="mt-3 list-disc space-y-2 pl-6">
              <li>Tous les fournisseurs de services Internet disponibles à un emplacement sont répertoriés.</li>
              <li>Les vitesses, technologies ou tarifs sont à jour ou exacts.</li>
              <li>Les cartes de couverture reflètent la disponibilité en temps réel à votre adresse spécifique.</li>
            </ul>
            <p class="mt-3">
              Chaque résultat de recherche comprend un <strong>score de confiance</strong> indiquant la fiabilité des données. Les résultats avec un score de confiance plus faible devraient être vérifiés directement auprès des fournisseurs de services.
            </p>
          </section>

          <section>
            <h2 class="text-xl font-bold text-[var(--color-text-primary)]">Aucune approbation</h2>
            <p class="mt-3">
              L'inscription d'un fournisseur ou d'un forfait ne constitue pas une approbation ou une recommandation. Nous ne sommes affiliés à aucun fournisseur de services Internet, sauf mention explicite. Les utilisateurs doivent vérifier indépendamment les détails des forfaits, les tarifs et la disponibilité avant de prendre des décisions d'achat.
            </p>
          </section>

          <section>
            <h2 class="text-xl font-bold text-[var(--color-text-primary)]">Limitation de responsabilité</h2>
            <p class="mt-3">
              FSI par adresse Canada ne sera pas responsable des dommages directs, indirects, accessoires ou consécutifs découlant de l'utilisation de ce service, y compris, mais sans s'y limiter, les décisions prises sur la base des données de couverture affichées. Ce service est fourni à titre informatif uniquement.
            </p>
          </section>

          <section>
            <h2 class="text-xl font-bold text-[var(--color-text-primary)]">Propriété intellectuelle</h2>
            <p class="mt-3">
              Les données de couverture large bande sous-jacentes sont des données ouvertes du gouvernement du Canada, assujetties à la <a href="https://ouvert.canada.ca/fr/licence-du-gouvernement-ouvert-canada" target="_blank" rel="noopener noreferrer" class="text-[var(--color-primary-500)] underline underline-offset-2 hover:text-[var(--color-primary-600)]">Licence du gouvernement ouvert — Canada</a>. La conception du site Web, le code et le contenu original sont la propriété de FSI par adresse Canada.
            </p>
          </section>

          <section>
            <h2 class="text-xl font-bold text-[var(--color-text-primary)]">Soumissions des utilisateurs</h2>
            <p class="mt-3">
              En soumettant un signalement d'écart ou une correction de données, vous nous accordez un droit non exclusif et libre de redevances d'utiliser ces informations pour améliorer l'exactitude de nos données.
            </p>
          </section>

          <section>
            <h2 class="text-xl font-bold text-[var(--color-text-primary)]">Modifications</h2>
            <p class="mt-3">
              Nous nous réservons le droit de modifier ces conditions à tout moment. Les modifications seront publiées sur cette page avec une date de révision mise à jour. L'utilisation continue du service constitue l'acceptation des conditions mises à jour.
            </p>
          </section>

          <section>
            <h2 class="text-xl font-bold text-[var(--color-text-primary)]">Droit applicable</h2>
            <p class="mt-3">
              Ces conditions sont régies par les lois de la province de l'Ontario et les lois fédérales du Canada qui y sont applicables.
            </p>
          </section>

          <section>
            <h2 class="text-xl font-bold text-[var(--color-text-primary)]">Contact</h2>
            <p class="mt-3">
              Si vous avez des questions concernant ces conditions, veuillez nous contacter à <span class="font-mono text-[var(--color-text-primary)]">legal@ispbyaddress.ca</span>.
            </p>
          </section>
        </div>
      </article>
    </div>
  </main>

  <Footer locale={locale} />
</BaseLayout>
