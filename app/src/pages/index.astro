---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/common/Header.astro";
import Footer from "@/components/common/Footer.astro";
import LookupForm from "@/components/lookup/LookupForm";
import { t } from "@/i18n/utils";

const locale = "en";
---

<BaseLayout
  title={t(locale, "seo.home_title")}
  description={t(locale, "seo.home_description")}
  locale={locale}
  canonicalPath="/"
>
  <Header locale={locale} />

  <main id="main-content">
    <!-- Hero / Lookup Section -->
    <section class="relative overflow-hidden bg-gradient-to-b from-[var(--color-primary-50)] to-[var(--color-surface)] pt-20 pb-28 md:pt-28 md:pb-36">
      <div class="container-page text-center">
        <h1 class="mx-auto max-w-4xl text-4xl font-bold tracking-tight text-[var(--color-text-primary)] md:text-5xl lg:text-[3.5rem] lg:leading-[1.1]">
          {t(locale, "lookup.form.title")}
        </h1>
        <p class="mx-auto mt-5 max-w-2xl text-lg text-[var(--color-text-secondary)] md:text-xl">
          {t(locale, "lookup.form.subtitle")}
        </p>
        <div class="mx-auto mt-10 max-w-xl">
          <LookupForm locale={locale} client:load />
        </div>

        <!-- Data credibility strip -->
        <div class="mx-auto mt-12 flex max-w-2xl flex-wrap items-center justify-center gap-x-6 gap-y-3 text-sm text-[var(--color-text-muted)]" aria-label="Key statistics">
          <span class="flex items-center gap-1.5">
            <span class="font-mono font-semibold text-[var(--color-text-secondary)]">16.6M</span>
            <span>data points</span>
          </span>
          <span class="hidden text-[var(--color-border)] sm:inline" aria-hidden="true">|</span>
          <span class="flex items-center gap-1.5">
            <span class="font-mono font-semibold text-[var(--color-text-secondary)]">50+</span>
            <span>providers</span>
          </span>
          <span class="hidden text-[var(--color-border)] sm:inline" aria-hidden="true">|</span>
          <span class="flex items-center gap-1.5">
            <span class="font-mono font-semibold text-[var(--color-text-secondary)]">100+</span>
            <span>cities</span>
          </span>
          <span class="hidden text-[var(--color-border)] sm:inline" aria-hidden="true">|</span>
          <span class="flex items-center gap-1.5">
            <span>{t(locale, "home.stats.updated")}</span>
          </span>
        </div>
      </div>

      <!-- Dot grid background pattern -->
      <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
        <div class="absolute inset-0 opacity-[0.03]" style="background-image: radial-gradient(var(--color-primary-700) 1px, transparent 1px); background-size: 32px 32px;"></div>
        <div class="absolute bottom-0 left-0 right-0 h-32 bg-gradient-to-t from-[var(--color-surface)] to-transparent"></div>
      </div>
    </section>

    <!-- Value Props — Asymmetric layout -->
    <section class="py-20 md:py-28">
      <div class="container-page">
        <div class="grid gap-8 lg:grid-cols-5 lg:gap-10">
          <!-- Left column: Confidence score preview (3/5 width) -->
          <div class="lg:col-span-3 rounded-[var(--radius-xl)] border border-[var(--color-border-subtle)] bg-[var(--color-surface-raised)] p-8 shadow-[var(--shadow-card)] md:p-10">
            <h2 class="text-2xl font-bold text-[var(--color-text-primary)] md:text-3xl">
              {t(locale, "home.confidence_preview.title")}
            </h2>
            <p class="mt-3 max-w-lg text-[var(--color-text-secondary)]">
              {t(locale, "home.confidence_preview.description")}
            </p>

            <!-- Mock confidence gauge -->
            <div class="mt-8 flex items-center gap-8">
              <div class="relative flex h-32 w-32 shrink-0 items-center justify-center">
                <!-- Background ring -->
                <svg class="absolute inset-0 h-full w-full -rotate-90" viewBox="0 0 120 120" aria-hidden="true">
                  <circle cx="60" cy="60" r="52" fill="none" stroke="var(--color-border)" stroke-width="10" />
                  <circle cx="60" cy="60" r="52" fill="none" stroke="var(--color-confidence-high)" stroke-width="10" stroke-dasharray="326.73" stroke-dashoffset="42.47" stroke-linecap="round" />
                </svg>
                <span class="font-mono text-4xl font-bold text-[var(--color-text-primary)]" aria-label="Confidence score: 87 out of 100">87</span>
              </div>

              <div class="flex flex-col gap-2.5 text-sm">
                <div class="flex items-center gap-2">
                  <span class="inline-block h-2.5 w-2.5 rounded-full bg-[var(--color-confidence-high)]" aria-hidden="true"></span>
                  <span class="text-[var(--color-text-secondary)]">70–100 <span class="font-semibold text-[var(--color-confidence-high)]">{t(locale, "home.confidence_preview.high")}</span></span>
                </div>
                <div class="flex items-center gap-2">
                  <span class="inline-block h-2.5 w-2.5 rounded-full bg-[var(--color-confidence-medium)]" aria-hidden="true"></span>
                  <span class="text-[var(--color-text-secondary)]">40–69 <span class="font-semibold text-[var(--color-confidence-medium)]">{t(locale, "home.confidence_preview.medium")}</span></span>
                </div>
                <div class="flex items-center gap-2">
                  <span class="inline-block h-2.5 w-2.5 rounded-full bg-[var(--color-confidence-low)]" aria-hidden="true"></span>
                  <span class="text-[var(--color-text-secondary)]">0–39 <span class="font-semibold text-[var(--color-confidence-low)]">{t(locale, "home.confidence_preview.low")}</span></span>
                </div>
              </div>
            </div>
          </div>

          <!-- Right column: Stacked cards (2/5 width) -->
          <div class="flex flex-col gap-8 lg:col-span-2">
            <!-- Precision card -->
            <div class="flex-1 rounded-[var(--radius-xl)] border border-[var(--color-border-subtle)] bg-[var(--color-surface-raised)] p-8 shadow-[var(--shadow-card)]">
              <h3 class="text-lg font-bold text-[var(--color-text-primary)]">
                {t(locale, "home.precision.title")}
              </h3>
              <div class="mt-4">
                <span class="font-mono text-4xl font-bold text-[var(--color-primary-500)]">{t(locale, "home.precision.stat")}</span>
              </div>
              <p class="mt-2 text-sm text-[var(--color-text-secondary)]">
                {t(locale, "home.precision.stat_label")}
              </p>
            </div>

            <!-- All providers card -->
            <div class="flex-1 rounded-[var(--radius-xl)] border border-[var(--color-border-subtle)] bg-[var(--color-surface-raised)] p-8 shadow-[var(--shadow-card)]">
              <h3 class="text-lg font-bold text-[var(--color-text-primary)]">
                {t(locale, "home.all_providers.title")}
              </h3>
              <!-- Technology type dots -->
              <div class="mt-4 flex items-center gap-3" aria-label="Five technology types: fibre, cable, fixed wireless, satellite, LTE">
                <span class="flex h-8 w-8 items-center justify-center rounded-full bg-[var(--color-tech-fibre)]/10">
                  <span class="h-3 w-3 rounded-full bg-[var(--color-tech-fibre)]"></span>
                </span>
                <span class="flex h-8 w-8 items-center justify-center rounded-full bg-[var(--color-tech-cable)]/10">
                  <span class="h-3 w-3 rounded-full bg-[var(--color-tech-cable)]"></span>
                </span>
                <span class="flex h-8 w-8 items-center justify-center rounded-full bg-[var(--color-tech-fixed-wireless)]/10">
                  <span class="h-3 w-3 rounded-full bg-[var(--color-tech-fixed-wireless)]"></span>
                </span>
                <span class="flex h-8 w-8 items-center justify-center rounded-full bg-[var(--color-tech-satellite)]/10">
                  <span class="h-3 w-3 rounded-full bg-[var(--color-tech-satellite)]"></span>
                </span>
                <span class="flex h-8 w-8 items-center justify-center rounded-full bg-[var(--color-tech-lte)]/10">
                  <span class="h-3 w-3 rounded-full bg-[var(--color-tech-lte)]"></span>
                </span>
              </div>
              <p class="mt-4 text-sm text-[var(--color-text-secondary)]">
                {t(locale, "home.all_providers.description")}
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Explore Section -->
    <section class="border-t border-[var(--color-border-subtle)] bg-[var(--color-surface-sunken)] py-20 md:py-28">
      <div class="container-page">
        <div class="text-center">
          <h2 class="text-2xl font-bold tracking-tight text-[var(--color-text-primary)] md:text-3xl">
            {t(locale, "home.explore.title")}
          </h2>
          <p class="mx-auto mt-3 max-w-lg text-[var(--color-text-secondary)]">
            {t(locale, "home.explore.subtitle")}
          </p>
        </div>

        <div class="mx-auto mt-12 grid max-w-4xl gap-4 sm:grid-cols-2 lg:grid-cols-3">
          <a href="/coverage" class="group rounded-[var(--radius-lg)] border border-[var(--color-border-subtle)] bg-[var(--color-surface-raised)] p-6 shadow-[var(--shadow-card)] transition-all hover:border-[var(--color-primary-300)] hover:shadow-[var(--shadow-card-hover)] hover:-translate-y-0.5">
            <div class="font-bold text-[var(--color-text-primary)] group-hover:text-[var(--color-primary-600)] transition-colors">{t(locale, "home.explore.coverage")}</div>
            <div class="mt-1.5 font-mono text-sm font-semibold text-[var(--color-primary-500)]">{t(locale, "home.explore.coverage_stat")}</div>
          </a>
          <a href="/providers" class="group rounded-[var(--radius-lg)] border border-[var(--color-border-subtle)] bg-[var(--color-surface-raised)] p-6 shadow-[var(--shadow-card)] transition-all hover:border-[var(--color-primary-300)] hover:shadow-[var(--shadow-card-hover)] hover:-translate-y-0.5">
            <div class="font-bold text-[var(--color-text-primary)] group-hover:text-[var(--color-primary-600)] transition-colors">{t(locale, "home.explore.providers")}</div>
            <div class="mt-1.5 font-mono text-sm font-semibold text-[var(--color-primary-500)]">{t(locale, "home.explore.providers_stat")}</div>
          </a>
          <a href="/technology" class="group rounded-[var(--radius-lg)] border border-[var(--color-border-subtle)] bg-[var(--color-surface-raised)] p-6 shadow-[var(--shadow-card)] transition-all hover:border-[var(--color-primary-300)] hover:shadow-[var(--shadow-card-hover)] hover:-translate-y-0.5">
            <div class="font-bold text-[var(--color-text-primary)] group-hover:text-[var(--color-primary-600)] transition-colors">{t(locale, "home.explore.technologies")}</div>
            <div class="mt-1.5 flex items-center gap-1.5">
              <span class="h-2 w-2 rounded-full bg-[var(--color-tech-fibre)]" aria-hidden="true"></span>
              <span class="h-2 w-2 rounded-full bg-[var(--color-tech-cable)]" aria-hidden="true"></span>
              <span class="h-2 w-2 rounded-full bg-[var(--color-tech-fixed-wireless)]" aria-hidden="true"></span>
              <span class="h-2 w-2 rounded-full bg-[var(--color-tech-satellite)]" aria-hidden="true"></span>
              <span class="h-2 w-2 rounded-full bg-[var(--color-tech-lte)]" aria-hidden="true"></span>
              <span class="ml-1 font-mono text-sm font-semibold text-[var(--color-primary-500)]">{t(locale, "home.explore.technologies_stat")}</span>
            </div>
          </a>
          <a href="/speeds" class="group rounded-[var(--radius-lg)] border border-[var(--color-border-subtle)] bg-[var(--color-surface-raised)] p-6 shadow-[var(--shadow-card)] transition-all hover:border-[var(--color-primary-300)] hover:shadow-[var(--shadow-card-hover)] hover:-translate-y-0.5">
            <div class="font-bold text-[var(--color-text-primary)] group-hover:text-[var(--color-primary-600)] transition-colors">{t(locale, "home.explore.speeds")}</div>
            <div class="mt-1.5 font-mono text-sm font-semibold text-[var(--color-primary-500)]">{t(locale, "home.explore.speeds_stat")}</div>
          </a>
          <a href="/compare" class="group rounded-[var(--radius-lg)] border border-[var(--color-border-subtle)] bg-[var(--color-surface-raised)] p-6 shadow-[var(--shadow-card)] transition-all hover:border-[var(--color-primary-300)] hover:shadow-[var(--shadow-card-hover)] hover:-translate-y-0.5">
            <div class="font-bold text-[var(--color-text-primary)] group-hover:text-[var(--color-primary-600)] transition-colors">{t(locale, "home.explore.compare")}</div>
            <div class="mt-1.5 font-mono text-sm font-semibold text-[var(--color-primary-500)]">{t(locale, "home.explore.compare_stat")}</div>
          </a>
          <a href="/guides" class="group rounded-[var(--radius-lg)] border border-[var(--color-border-subtle)] bg-[var(--color-surface-raised)] p-6 shadow-[var(--shadow-card)] transition-all hover:border-[var(--color-primary-300)] hover:shadow-[var(--shadow-card-hover)] hover:-translate-y-0.5">
            <div class="font-bold text-[var(--color-text-primary)] group-hover:text-[var(--color-primary-600)] transition-colors">{t(locale, "home.explore.guides")}</div>
            <div class="mt-1.5 font-mono text-sm font-semibold text-[var(--color-primary-500)]">{t(locale, "home.explore.guides_stat")}</div>
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer locale={locale} />
</BaseLayout>
