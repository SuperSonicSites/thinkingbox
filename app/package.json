{
  "name": "isp-by-address-canada",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit",
    "db:migrate": "psql $DATABASE_URL -f ../scripts/migrate/001-initial-schema.sql",
    "db:seed:plans": "npx tsx ../scripts/seed/seed-mock-plans.ts",
    "db:seed:addresses": "npx tsx ../scripts/seed/seed-test-addresses.ts",
    "db:ingest:phh": "npx tsx ../scripts/ingest/load-phh-points.ts",
    "db:ingest:speeds": "npx tsx ../scripts/ingest/load-phh-speeds.ts",
    "db:ingest:hex": "npx tsx ../scripts/ingest/load-hex-isp.ts",
    "db:ingest:boundaries": "npx tsx ../scripts/ingest/load-boundaries.ts",
    "eval:data-quality": "npx tsx ../evals/data-quality.ts",
    "eval:lookup": "npx tsx ../evals/lookup-accuracy.ts",
    "eval:api": "npx tsx ../evals/api-contracts.ts",
    "eval:parity": "npx tsx ../evals/ui-parity.ts"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.0.0",
    "@astrojs/react": "^4.0.0",
    "@fontsource-variable/dm-sans": "^5.0.0",
    "@fontsource-variable/jetbrains-mono": "^5.0.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.0.0",
    "astro": "^5.0.0",
    "lucide-react": "^0.460.0",
    "postgres": "^3.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@playwright/test": "^1.48.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^25.2.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "csv-parse": "^5.5.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.4.1",
    "vitest": "^2.0.0",
    "wrangler": "^3.90.0"
  }
}
